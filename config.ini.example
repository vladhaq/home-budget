; Скопируй в config.ini и заполни. config.ini содержит секреты — никому не отправляй.

[telegram]
; https://my.telegram.org -> API development tools
api_id =
api_hash =
; ссылка-приглашение группы, куда отправляешь фото чеков
receipts_chat = https://t.me/+...

[mail]
imap_host = imap.gmail.com
; адрес Gmail (если пусто — mail login спросит)
user =
; пароль приложения Google хранится не здесь, а в диспетчере учётных данных: python budget.py mail login

[backup]
; основная папка копий (по умолчанию budget\backups)
; dir = D:\budget-backups
; вторая папка: флешка, OneDrive... (копии зашифрованы)
; copy_to = D:\Backup\budget
keep = 10

[cards]
; подписи карт других счетов: последние 4 цифры = название
; 1234 = карта другого банка

[update]
; как часто делать резервную копию при обновлении, в днях (0 — не делать)
backup_every_days = 1

; ---------------- свои правила (всё необязательно) ----------------
; То, что относится только к тебе: работодатель, вуз, свои заведения. Шаблон — часть текста маленькими буквами
; без польских знаков (ł -> l, ó -> o), варианты через |. Категория — ключ из core/categories.py (TREE):
; food.nocheck, housing.rent, education, income.salary, leisure.cafe ...

[bank]
; свои небольшие города, склеенные с названием в выписке («OLAWASKLEP …»), через запятую
; cities = olawa, sobotka

[bank_rules]
; операция выписки без чека: шаблон = категория
; moja uczelnia = education

[income_rules]
; поступление: шаблон (отправитель, описание) = категория
; nazwa pracodawcy = income.salary

[merchants]
; шаблон в описании операции = название магазина
; pizzeria roma = Pizzeria Roma

[shops]
; магазин = категория, всегда (билеты, визиты, учёба — по названию позиции не понять)
; Moja Uczelnia = education

[shops_hint]
; магазин = категория, если словарь товар не узнал
; Sklep Przyklad = goods.electronics

[mail_domains]
; домен писем магазина = название
; sklep-przyklad.pl = Sklep Przyklad

[mail_payees]
; получатель в письмах Przelewy24 / PayU / Tpay: шаблон = название
; moja uczelnia = Moja Uczelnia
