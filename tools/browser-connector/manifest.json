{
  "manifest_version": 3,
  "name": "Budget Browser Connector",
  "version": "1.3.1",
  "description": "Connects supported websites to the local home-budget app.",
  "permissions": ["cookies"],
  "host_permissions": [
    "https://biedronka.pl/*",
    "https://*.biedronka.pl/*",
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*"
  ],
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1:8765/*", "http://localhost:8765/*"],
      "js": ["detect.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Budget Browser Connector",
    "default_popup": "popup.html"
  }
}
